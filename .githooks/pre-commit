#!/bin/sh
# Task board + sheet parity (decisions.md 2026-09-24). nra_tasks.py precommit:
#  - from a Claude session (CLAUDE_CODE_SESSION_ID set): refuses a commit when a staged file belongs to another
#    session or to nobody, and when the STAGED sheet and site data disagree (check_sheet_parity.py).
#  - from Terminal (no session id): never blocks; prints the same findings as warnings.
# `git commit --no-verify` from Terminal skips it. Enable once per clone:  git config core.hooksPath .githooks
root=$(git rev-parse --show-toplevel)
exec python3 "$root/.githooks/nra_tasks.py" precommit
