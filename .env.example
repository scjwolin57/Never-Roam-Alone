# Copy this file to ".env" for local testing with the Netlify CLI, and set the
# same variables in Netlify (Site settings -> Environment variables) for production.
# NEVER commit your real keys to git or paste them into any .html/.js file.

# SerpApi — live flight/destination search.  https://serpapi.com/manage-api-key
SERPAPI_KEY=your-serpapi-key-here

# Unsplash — city landmark photos.  https://unsplash.com/oauth/applications  (use the "Access Key")
UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here

# Pexels — landmark photo replacements.  https://www.pexels.com/api/new/
PEXELS_API_KEY=your-pexels-api-key-here

# Pixabay — landmark photo replacements.  https://pixabay.com/api/docs/
PIXABAY_API_KEY=your-pixabay-api-key-here

# Translation (long-form blog/city articles) uses MyMemory, which needs NO key,
# NO signup, and NO credit card. It works out of the box.
# OPTIONAL: add a contact email to raise the free daily limit from 5,000 to
# 50,000 characters/day. Leave blank to use the anonymous tier.
MYMEMORY_EMAIL=

# Resend — sends reply-notification emails, city guide requests, and the
# mailing-list confirmation email (netlify/functions/subscribe.js).
# https://resend.com (free tier). Already used by netlify/functions/notify.js.
RESEND_API_KEY=your-resend-api-key-here

# Your live site address, e.g. https://neverroamalone.com — used in the
# footer/links of some emails (optional).
SITE_URL=

# Where "Request city guide" emails go (your own email address).
# Used by netlify/functions/request-guide.js.
GUIDE_REQUEST_EMAIL=you@example.com

# Where Contact and Site Feedback form submissions go (your own email
# address). Used by netlify/functions/contact.js and netlify/functions/feedback.js.
# If left blank, falls back to GUIDE_REQUEST_EMAIL above.
CONTACT_EMAIL=you@example.com
