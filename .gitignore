# Staging clone used while building new city guides (~281 MB). This lived in
# .git/info/exclude, which is local-only and isn't shared or backed up — a
# fresh clone would have committed and published the whole folder.
_cities-staging/

# Real API keys (SerpApi, Unsplash, Pexels, Pixabay, Resend...). Only the
# .env.example template belongs in git.
.env
.env.*
!.env.example

# macOS Finder metadata — never useful in the repo.
.DS_Store
